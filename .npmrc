# npm configuration
# https://docs.npmjs.com/cli/v10/configuring-npm/npmrc

# Save exact versions
save-exact=true

# Use HTTPS for git dependencies
git-tag-version=false

# Disable funding messages
fund=false

# Disable audit in CI
audit=false

# Use color in output
color=true

# Log level
loglevel=warn

# Registry
registry=https://registry.npmjs.org/
